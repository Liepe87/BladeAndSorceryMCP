# Blade & Sorcery MCP sidecar - environment configuration
#
# 1. Copy this file to .env (same folder):
#      copy .env.example .env
# 2. Fill in your OpenRouter API key (https://openrouter.ai/keys)
# 3. Restart the sidecar. It picks up the key automatically.
#
# The .env file is gitignored - never commit it.

# OpenRouter API key for the LLM game master (tier 2).
# Without a valid key the game master runs its rule-based tier only.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
